; Config PHP base por proyecto (montada como zz-project.ini en el container).
; El panel puede regenerar este archivo; el asistente IA puede ajustarlo.
memory_limit = 256M
upload_max_filesize = 64M
post_max_size = 64M
max_execution_time = 120
max_input_vars = 3000
display_errors = On
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
date.timezone = UTC
